// Prisma schema for Banya/Sauna portal — Phase 1 full data model
// Generated on 2026-11-01

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum Role {
  CLIENT
  PARTNER
  ADMIN
}

enum VenueStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
  DRAFT
  PAID
  IN_PROGRESS
  CANCELLED_BY_CLIENT
  CANCELLED_BY_OWNER
  CANCELLED_BY_ADMIN
  NO_SHOW
  DISPUTED
  REFUNDED
}

enum BookingMode {
  instant
  confirm
  pay_on_site
}

enum ChatParticipantRole {
  client
  partner
  admin
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  EXPIRED
}

enum PaymentProvider {
  mock
  cloudpayments
  yookassa
  tinkoff
}

// --- Models ---

model City {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  timezone  String   @default("Europe/Moscow")
  venues    Venue[]
  districts District[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id               String                 @id @default(cuid())
  email            String                 @unique
  phone            String?                @unique
  telegramChatId   String?
  firstName        String?
  lastName         String?
  birthDate        DateTime?
  passwordHash     String
  role             Role                   @default(CLIENT)
  status           String                 @default("active")
  adminRole        String?
  profile          UserProfile?
  referredById     String?
  referredBy       User?                  @relation("Referral", fields: [referredById], references: [id])
  referrals        User[]                 @relation("Referral")
  purchasedGifts   GiftCertificate[]      @relation("GiftPurchaser")
  redeemedGifts    GiftCertificate[]      @relation("GiftRedeemer")
  partner          Partner?
  refreshTokens    RefreshToken[]
  bookings         Booking[]
  reviews          Review[]
  promoUsages      PromoCodeUsage[]
  notifications    Notification[]
  favorites        Favorite[]
  chatParticipants ChatParticipant[]
  chatMessages     ChatMessage[]
  statusChanges    BookingStatusHistory[]
  reviewResponses  ReviewResponse[]
  adminAuditLogs   AdminAuditLog[]
  supportTickets   SupportTicket[]
  assignedTickets  SupportTicket[]        @relation("SupportTicketAssignment")
  waitlistEntries  WaitlistEntry[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  twoFAEnabled     Boolean                @default(false)
  twoFASecret      String?
  twoFAActivatedAt DateTime?
  backupCodes      String?
}

model Partner {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id])
  companyName String?
  inn         String?
  status      String       @default("pending")
  venues      Venue[]
  payouts     Payout[]
  adCampaigns AdCampaign[]
  certificates Certificate[]
  staffMembers StaffMember[]
  tariffs     Tariff[]
  chatTemplates ChatTemplate[]
  documents    PartnerDocument[]
  payoutDetails PartnerPayoutDetails?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Venue {
  id               String           @id @default(cuid())
  partnerId        String
  partner          Partner          @relation(fields: [partnerId], references: [id])
  cityId           String
  city             City             @relation(fields: [cityId], references: [id])
  title            String
  slug             String           @unique
  description      String           @db.Text
  address          String
  district         String?
  districtId       String?
  districtRef      District?  @relation(fields: [districtId], references: [id])
  objectType       String?
  objectTypeId     String?
  objectTypeRef    ObjectType? @relation(fields: [objectTypeId], references: [id])
  metroStation     String?
  phone            String?
  email            String?
  website          String?
  socialLinks      Json?
  lat              Float?
  lng              Float?
  type             String // bath / sauna
  minGuests        Int              @default(1)
  maxGuests        Int
  minDuration      Int              @default(60) // minutes
  priceFrom        Int // rubles
  priceWeekend     Int?
  priceNight       Int?
  nightStartHour   Int              @default(22)
  nightEndHour     Int              @default(6)
  rules            String?          @db.Text
  bufferMinutes    Int              @default(0)
  minDurationMinutes Int            @default(60)
  maxDurationMinutes Int            @default(480)
  bookingStepMinutes Int            @default(30)
  leadTimeMinutes  Int              @default(120)
  maxHorizonDays   Int              @default(730)
  cancellationPolicy String?         @db.Text
  status           VenueStatus      @default(DRAFT)
  moderationStatus ModerationStatus @default(PENDING)
  publishedAt      DateTime?
  showContactsBeforeBooking Boolean  @default(true)
  photos           VenuePhoto[]
  videos           VenueVideo[]
  amenities        VenueAmenity[]
  bookings         Booking[]
  reviews          Review[]
  favorites        Favorite[]
  services         Service[]
  specialOffers    SpecialOffer[]
  packages         Package[]
  schedules        VenueSchedule[]
  exceptions       AvailabilityException[]
  icalSyncJobs     ICalSyncJob[]
  waitlistEntries  WaitlistEntry[]
  qualityScore     Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([cityId, status, moderationStatus])
  @@index([partnerId])
}

model Amenity {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  icon      String?
  venues    VenueAmenity[]
  createdAt DateTime       @default(now())
}

model Package {
  id          String   @id @default(cuid())
  venueId     String?
  venue       Venue?   @relation(fields: [venueId], references: [id])
  name        String
  description String?  @db.Text
  price       Int
  includes    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([venueId])
}

model GiftCertificate {
  id            String   @id @default(cuid())
  code          String   @unique
  amount        Int // rubles
  status        String   @default("active") // active, redeemed, expired
  purchaserId   String?
  purchaser     User?    @relation("GiftPurchaser", fields: [purchaserId], references: [id])
  recipientEmail String?
  redeemedById  String?
  redeemedBy    User?    @relation("GiftRedeemer", fields: [redeemedById], references: [id])
  redeemedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([code])
}

model District {
  id        String   @id @default(cuid())
  name      String
  cityId    String
  city      City     @relation(fields: [cityId], references: [id])
  venues    Venue[]
  createdAt DateTime @default(now())

  @@unique([cityId, name])
  @@index([cityId])
}

model ObjectType {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  venues    Venue[]
  createdAt DateTime @default(now())
}

model UserProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String?
  lastName    String?
  birthDate   DateTime?
  avatarUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PartnerDocument {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id])
  type      String // inn, ogrn, passport, etc.
  url       String
  status    String   @default("pending") // pending, approved, rejected
  createdAt DateTime @default(now())

  @@index([partnerId])
}

model PartnerPayoutDetails {
  id            String   @id @default(cuid())
  partnerId     String   @unique
  partner       Partner  @relation(fields: [partnerId], references: [id])
  bankName      String?
  accountNumber String?
  bik           String?
  recipientName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Content {
  id        String   @id @default(cuid())
  slug     String   @unique
  title    String
  body     String   @db.Text
  status   String   @default("draft") // draft | published
  locale   String   @default("ru")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model SeoPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?  @db.Text
  content     String?  @db.Text
  locale      String   @default("ru")
  moderationStatus String @default("APPROVED") // PENDING | APPROVED | REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  label     String?  @default("Реклама")
  position  String   @default("home") // home | catalog | sidebar
  isActive  Boolean  @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int      @default(0)
  moderationStatus String @default("APPROVED") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?  @db.Text
  itemIds     Json? // array of venue ids
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  moderationStatus String @default("APPROVED") // PENDING | APPROVED | REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tariff {
  id          String   @id @default(cuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id])
  name        String
  description String?  @db.Text
  type        String   @default("promotion") // promotion / commission / addon
  price       Int // rubles
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([partnerId])
}

model SpecialOffer {
  id            String   @id @default(cuid())
  venueId       String
  venue         Venue    @relation(fields: [venueId], references: [id])
  name          String
  discountType  String   @default("percent") // percent / fixed
  discountValue Int // percent (1-100) or rubles
  validFrom     DateTime?
  validTo       DateTime?
  daysOfWeek    String? // comma-separated 0-6 (0=Sun)
  timeFrom      String? // "HH:MM"
  timeTo        String? // "HH:MM"
  minHours      Int      @default(1)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([venueId])
}

model VenueAmenity {
  venueId   String
  amenityId String
  venue     Venue   @relation(fields: [venueId], references: [id])
  amenity   Amenity @relation(fields: [amenityId], references: [id])

  @@id([venueId, amenityId])
}

model VenueSchedule {
  id         String   @id @default(cuid())
  venueId    String
  venue      Venue    @relation(fields: [venueId], references: [id])
  dayOfWeek  Int
  openTime   String
  closeTime  String
  isClosed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([venueId, dayOfWeek])
  @@index([venueId])
}

model AvailabilityException {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id])
  date      DateTime
  isClosed  Boolean  @default(false)
  openTime  String?
  closeTime String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([venueId, date])
}

model VenuePhoto {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id])
  url       String
  key       String
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  category  String?  // парная, отдых, бассейн, территория, экстерьер, другое
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String    @id @default(cuid())
  jti       String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Booking {
  id              String                 @id @default(cuid())
  venueId         String
  venue           Venue                  @relation(fields: [venueId], references: [id])
  userId          String
  user            User                   @relation(fields: [userId], references: [id])
  startsAt        DateTime
  endsAt          DateTime
  status          BookingStatus          @default(PENDING)
  bookingMode     BookingMode            @default(instant)
  allowBackToBack Boolean                @default(false)
  totalPrice      Int?
  prepaymentAmount Int?
  paidAmount     Int?
  cancellationReason String?
  cancelledBy    String?
  cancelledAt    DateTime?
  services        BookingService[]
  conversation    ChatConversation?
  payment         Payment?
  review          Review?
  promoUsage      PromoCodeUsage?
  statusHistories BookingStatusHistory[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([venueId, startsAt, endsAt])
  @@index([userId])
}

model Service {
  id           String           @id @default(cuid())
  venueId      String
  venue        Venue            @relation(fields: [venueId], references: [id])
  name         String
  defaultPrice Int
  bookings     BookingService[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model BookingService {
  id             String  @id @default(cuid())
  bookingId      String
  booking        Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service @relation(fields: [serviceId], references: [id])
  quantity       Int     @default(1)
  priceAtBooking Int

  @@index([bookingId])
}

model ChatConversation {
  id           String            @id @default(cuid())
  bookingId    String            @unique
  booking      Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  participants ChatParticipant[]
  messages     ChatMessage[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model ChatParticipant {
  id             String              @id @default(cuid())
  conversationId String
  conversation   ChatConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  role           ChatParticipantRole
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User             @relation(fields: [senderId], references: [id])
  body           String           @db.Text
  attachments    ChatAttachment[]
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model ChatAttachment {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String
  type      String      // image / document
  name      String?
  size      Int?
  createdAt DateTime    @default(now())

  @@index([messageId])
}

model ChatTemplate {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id])
  name      String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
}

model Payment {
  id                String          @id @default(cuid())
  bookingId         String          @unique
  booking           Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider          PaymentProvider @default(mock)
  providerPaymentId String?
  amount            Int // in kopecks (rubles * 100)
  status            PaymentStatus   @default(PENDING)
  paymentUrl        String?
  metadata          Json?
  refunds           Refund[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  paidAt            DateTime?
  refundedAt        DateTime?

  @@index([bookingId])
  @@index([status])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Review {
  id        String           @id @default(cuid())
  bookingId String           @unique
  booking   Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  venueId   String
  venue     Venue            @relation(fields: [venueId], references: [id])
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  rating    Int // 1-5
  comment   String
  criteria  Json? // {cleanliness, sauna, service, accuracy, value}
  status    ReviewStatus     @default(PENDING)
  response  String? // partner response
  responseAt DateTime?
  complaintReason String?
  complainedAt DateTime?
  complaintResolved Boolean @default(false)
  photos    ReviewPhoto[]
  responses ReviewResponse[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([venueId])
  @@index([userId])
  @@index([status])
}

model ReviewPhoto {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())

  @@index([reviewId])
}

model PromoCode {
  id               String           @id @default(cuid())
  code             String           @unique
  discountType     DiscountType     @default(PERCENTAGE)
  discountValue    Int // 10 = 10%, or 500 = 500 RUB
  minAmount        Int? // minimum booking amount in kopecks
  maxUses          Int? // total usage limit
  maxUsesPerUser   Int? // per-user limit
  validFrom        DateTime         @default(now())
  validUntil       DateTime
  applicableVenues Json? // array of venue IDs, null = all
  active           Boolean          @default(true)
  usages           PromoCodeUsage[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([code])
  @@index([active])
}

model PromoCodeUsage {
  id              String    @id @default(cuid())
  promoCodeId     String
  promoCode       PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  bookingId       String    @unique
  booking         Booking   @relation(fields: [bookingId], references: [id])
  discountApplied Int // discount amount in kopecks
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([bookingId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // booking_confirmed, payment_confirmed, reminder, cancelled, review_request
  channel   String // email, sms
  subject   String
  body      String    @db.Text
  status    String    @default("pending") // pending, sent, failed
  sentAt    DateTime?
  error     String?
  attempts  Int       @default(0)
  metadata  Json?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([status])
}

model NotificationTemplate {
  id       String  @id @default(cuid())
  code     String  @unique // booking_confirmed, payment_confirmed, reminder, review_request, waitlist_slot_freed, booking_cancelled, partner_new_booking
  channel  String // email, sms, telegram
  subject  String
  body     String  @db.Text // supports {{variables}}
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Extended Models (Phase 11) ---

enum VideoStatus {
  PENDING
  APPROVED
  REJECTED
}

model VenueVideo {
  id          String      @id @default(cuid())
  venueId     String
  venue       Venue       @relation(fields: [venueId], references: [id])
  url         String
  key         String
  sortOrder   Int         @default(0)
  isCover     Boolean     @default(false)
  status      VideoStatus @default(PENDING)
  moderatedAt DateTime?
  moderatedBy String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([venueId])
}

model BookingStatusHistory {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus  String?
  toStatus    String
  changedById String?
  changedBy   User?    @relation(fields: [changedById], references: [id])
  reason      String?
  createdAt   DateTime @default(now())

  @@index([bookingId])
}

model Refund {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount      Int // in kopecks
  reason      String?
  status      String   @default("pending") // pending, approved, rejected, completed
  providerRef String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([paymentId])
}

model Payout {
  id        String    @id @default(cuid())
  partnerId String
  partner   Partner   @relation(fields: [partnerId], references: [id])
  amount    Int // in kopecks
  status    String    @default("pending") // pending, processing, completed, cancelled
  method    String? // bank, card, sbp
  details   Json?
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([partnerId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, venueId])
  @@index([userId])
}

model ReviewResponse {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewId])
}

enum AdType {
  BANNER
  LISTING
  FEATURED
}

model AdCampaign {
  id        String    @id @default(cuid())
  partnerId String
  partner   Partner   @relation(fields: [partnerId], references: [id])
  title     String
  type      AdType    @default(BANNER)
  imageUrl  String?
  targetUrl String?
  budget    Int // total budget in kopecks
  spent     Int       @default(0) // spent in kopecks
  status    String    @default("draft") // draft, active, paused, completed
  startsAt  DateTime
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([partnerId])
}

model NotificationLog {
  id          String   @id @default(cuid())
  userId      String?
  channel     String // email, sms, push
  type        String
  subject     String?
  body        String   @db.Text
  status      String   @default("pending") // pending, sent, failed, bounced
  providerRef String?
  error       String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model ICalSyncJob {
  id             String    @id @default(cuid())
  venueId        String
  venue          Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sourceUrl      String // external iCal URL
  status         String    @default("pending") // pending, completed, failed
  eventsImported Int       @default(0)
  lastError      String?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([venueId])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String // create, update, delete, approve, reject
  entityType String // venue, review, user, booking, payment
  entityId   String
  oldValues  Json?
  newValues  Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
}

model SupportTicket {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    String
  body       String   @db.Text
  status     String   @default("open") // open, in_progress, resolved, closed
  priority   String   @default("medium") // low, medium, high, urgent
  assignedTo String?
  assigned   User?    @relation("SupportTicketAssignment", fields: [assignedTo], references: [id])
  slaDueAt   DateTime?
  slaAlertedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

