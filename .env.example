# Database — local Postgres or docker-compose (port 5433 maps to container 5432)
# docker compose up -d  →  postgresql://banya:banya_password@localhost:5433/banya_dev?schema=public
DATABASE_URL="postgresql://banya:banya_password@localhost:5433/banya_dev?schema=public"

# JWT secrets (generate with: openssl rand -hex 32)
JWT_SECRET="change-me-to-a-secure-secret-at-least-32-chars-long"
JWT_REFRESH_SECRET="change-me-to-another-secure-secret-32-chars-long"

# App
NODE_ENV="development"
