# Database
DATABASE_URL="postgresql://banya:banya@localhost:5432/banya_dev"

# JWT Secrets (change in production!)
JWT_ACCESS_SECRET="your-access-secret-change-me"
JWT_REFRESH_SECRET="your-refresh-secret-change-me"

# Server
PORT=3000
NODE_ENV=development

# Payment Provider (mock for MVP)
PAYMENT_PROVIDER=mock

# Email (mock for MVP)
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@banya.local

# Redis (optional)
REDIS_URL="redis://localhost:6379"

# Logging
LOG_LEVEL=info
