# =======================================================
# Banya.Sauna - Real Integration Configuration
# =======================================================

# CloudPayments Integration
CLOUDPAYMENTS_PUBLIC_KEY=cp_test_public_key
CLOUDPAYMENTS_SECRET_KEY=cp_test_secret_key
CLOUDPAYMENTS_BASE_URL=https://api.cloudpayments.ru

# Email Integration (SendGrid)
SENDGRID_API_KEY=SG.test_key
FROM_EMAIL=noreply@banya.sauna

# Email Integration (SES)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# SMS Integration (Twilio)
TWILIO_ACCOUNT_SID=test_sid
TWILIO_AUTH_TOKEN=test_token
TWILIO_FROM_NUMBER=+1234567890

# Application URLs
NEXT_PUBLIC_APP_URL=https://banya-sauna.local
FROM_EMAIL=noreply@banya.sauna

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/banya

# Security
JWT_SECRET=your-jwt-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret

# Webhook Settings
WEBHOOK_SECRET=your-webhook-secret-key
WEBHOOK_TIMEOUT_MS=30000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Cache
REDIS_URL=redis://localhost:6379